{
  "name": "douban-import",
  "version": "0.1.0",
  "description": "Import Douban media metadata and personal records into a local Obsidian vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "keywords": [
    "obsidian",
    "douban",
    "media",
    "personal-library"
  ],
  "author": "threeyang3",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/jest": "^28.1.4",
    "@types/node": "^16.11.6",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "builtin-modules": "^3.2.0",
    "esbuild": "0.13.12",
    "jest": "^28.1.2",
    "obsidian": "1.12.3",
    "ts-jest": "^28.0.5",
    "tslib": "2.3.1",
    "typescript": "^4.7.2",
    "vitepress": "^1.6.3"
  },
  "dependencies": {
    "@notable/html2markdown": "^1.1.3",
    "@popperjs/core": "^2.11.6",
    "cheerio": "^1.0.0-rc.11",
    "follow-redirects": "^1.15.6",
    "qrcode": "^1.5.4",
    "schema-dts": "^1.1.0"
  },
  "homepage": "https://github.com/threeyang3/douban-import",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threeyang3/douban-import.git"
  },
  "bugs": {
    "url": "https://github.com/threeyang3/douban-import/issues"
  }
}
